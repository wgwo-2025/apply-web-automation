# Only needed for scenarios with "loanpro": { "enabled": true } — i.e. the
# document-upload branch, which dead-ends in the underwriting queue without a
# backend nudge. The happy path (test-data.json) needs none of this.
#
# Copy to .env and fill in, or just export these in your shell.

# LoanPro API bearer token for the ORIGINATIONS SANDBOX tenant.
# Ask whoever manages LoanPro API credentials for this repo — do not reuse a
# production token, and never commit the real value.
LOANPRO_TOKEN=

# Originations sandbox tenant (database 5203310_S). This is the tenant go-dev
# writes to. 5203309 is originations PRODUCTION — do not point this there.
LOANPRO_TENANT=5203310
